% Delimited Lists
\def\my@concat #1,#2\@eolst{%
   \ifx\relax#2\relax
      #1
   \else
      #1\my@delim
      \my@concat #2\@eolst%
   \fi}

\newcommand\lbr[2][;\,]{%                  
\global\def\my@delim{#1}%
\br{\my@concat #2,\relax\noexpand\@eolst%
}}

\newcommand\lpa[2][,\,]{%                  
\global\def\my@delim{#1}%
\pa{\my@concat #2,\relax\noexpand\@eolst%
}}

\newcommand\lset[2][,\,]{%                  
\global\def\my@delim{#1}%
\set{\my@concat #2,\relax\noexpand\@eolst%
}}

