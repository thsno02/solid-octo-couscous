{"kind": "paragraph", "local_path": "materialized_sources/corpus/blog-GraphRAG-Improving-global-search-via-dynamic-community-selection--a813613c/document.md", "ordinal": 4, "selector": "web://261e4b7a025f57c1#B4", "text_preview": "Share this page"}
