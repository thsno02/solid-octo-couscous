% Repeat figures with custom captions
\NewDocumentCommand{\repeatcaption}{mmO{}}{%
  \renewcommand{\thefigure}{\ref{#1}}%
  \captionsetup{list=no}%
  \caption{\emph{Repeated from page \pageref{#1} #3.} #2}%
  \addtocounter{figure}{-1} % don't count this as a new figure
}

