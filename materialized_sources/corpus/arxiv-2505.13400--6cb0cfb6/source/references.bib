	file = {Full Text:/Users/alighareeb/Zotero/storage/IMUH4KIH/Yamaguchi et al. - 2017 - Rho-KinaseROCK as a Potential Drug Target for Vitreoretinal Diseases.pdf:application/pdf},
}

@article{fang_rhoa_2011,
	title = {{RhoA} activation and effect of {Rho}-kinase inhibitor in the development of retinal neovascularization in a mouse model of oxygen-induced retinopathy},
	volume = {36},
	issn = {1460-2202},
	doi = {10.3109/02713683.2011.593110},
	abstract = {PURPOSE: To study RhoA activation and the effect of the Rho-kinase inhibitor in the development of retinal neovascularization in a mouse model of oxygen-induced retinopathy (OIR).
METHODS: C57BL/6 mice at postnatal day (P7) were exposed to hyper-oxygen for 5 days and returned to room air for 5 days to induce OIR. RhoA-GTP, an active form of RhoA, in retinas at P12, P13 and P17 was detected. Mice received a single intravitreal injection of Y27632 (5 µM or 50 µM), a Rho-kinase inhibitor, in one eye during the transition from oxygen to room air at P12. Contralateral eyes were used as the control. Fluorescein-conjugated dextran angiography of retinal whole mount was prepared to score features of neovascular retinopathy at P17. The preretinal neovascular nuclei quantification was performed in frozen sections as well to evaluate the neovascularization.
RESULTS: The retinal RhoA-GTP in OIR mice significantly increased from 0.24 ± 0.06 at P12 to 0.38 ± 0.12 at P13 (p {\textless} 0.05). The median total retinopathy score of 5.7 was significantly lower in eyes treated with Y27632 than controls (p {\textless} 0.001). Significant improvement was found in the specific categories of vascular tufts (p {\textless} 0.01) and extraretinal neovascularization (p {\textless} 0.05) in treated eyes. Those treated eyes also had a significantly decreased number of neovascular nuclei (p {\textless} 0.01).
CONCLUSIONS: These results suggest that Rho/Rho-kinase signaling pathways are involved in the early process of hypoxia-induced retinal neovascularization and Y27632 might have therapeutic potential for the treatment of retinal neovascularization.},
	language = {eng},
	number = {11},
	journal = {Current Eye Research},
	author = {Fang, Xiaoyun and Ueno, Masaki and Yamashita, Toshihide and Ikuno, Yasushi},
	month = nov,
	year = {2011},
	pmid = {21999228},
	keywords = {Animals, Animals, Newborn, Mice, Signal Transduction, Disease Models, Animal, Mice, Inbred C57BL, Fluorescein Angiography, Follow-Up Studies, Treatment Outcome, Retina, Enzyme Inhibitors, Enzyme Activation, Amides, Fundus Oculi, Intravitreal Injections, Oxygen, Pyridines, Retinal Neovascularization, rho GTP-Binding Proteins, rho-Associated Kinases, rhoA GTP-Binding Protein},
	pages = {1028--1036},
}

