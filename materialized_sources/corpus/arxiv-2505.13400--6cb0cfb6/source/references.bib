@article{lei_role_2008,
	title = {The {Role} of {Akt}-{GSK}-3\textbeta {Signaling} and {Synaptic} {Strength} in {Phencyclidine}-{Induced} {Neurodegeneration}},
	volume = {33},
	copyright = {2008 American College of Neuropsychopharmacology},
	issn = {1740-634X},
	url = {https://www.nature.com/articles/1301511},
	doi = {10.1038/sj.npp.1301511},
	abstract = {N-methyl-D-aspartate (NMDA) receptor antagonists such as phencyclidine (PCP) can induce positive and negative symptoms of schizophrenia in humans and related effects in rodents. PCP treatment of developing rats induces apoptotic neurodegeneration and behavioral deficits later in life that mimic some symptoms of schizophrenia. The precise mechanism of PCP-induced neural degeneration is unknown. This study used selective antagonists, siRNA, and Western analysis to investigate the role of the Akt-glycogen synthase kinase-3\textbeta (GSK-3\textbeta) pathway in PCP-induced neuronal apoptosis in both neuronal culture and postnatal day 7 rats. PCP administration in vivo and in vitro reduced the phosphorylation of AktSer427 and GSK-3\textbetaSer9, decreasing Akt activity and increasing GSK-3\textbeta activity. The alteration of Akt-GSK-3\textbeta signaling parallels the temporal profile of caspase-3 activation by PCP. Reducing GSK-3\textbeta activity by application of selective inhibitors or depletion of GSK-3\textbeta by siRNA attenuates caspase-3 activity and blocks PCP-induced neurotoxicity. Moreover, increasing synaptic strength by either activation of L-type calcium channels with BAY K8644 or potentiation of synaptic NMDA receptors with either a low concentration of NMDA or bicuculline plus 4-aminopyridine completely blocks PCP-induced cell death by increasing Akt phosphorylation. These neuroprotective effects are associated with activation of phosphoinositide-3-kinase-Akt signaling, and to a lesser extent, the MAPK signaling pathway. Overall, these data suggest that PCP-induced hypofunction of synaptic NMDA receptors impairs the Akt-GSK-3\textbeta cascade, which is necessary for neuronal survival during development, and that interference with this cascade by PCP or natural factors may contribute to neural pathologies, perhaps including schizophrenia.},
	language = {en},
	number = {6},
	urldate = {2025-05-17},
	journal = {Neuropsychopharmacology},
	author = {Lei, Gang and Xia, Yan and Johnson, Kenneth M.},
	month = may,
	year = {2008},
	note = {Publisher: Nature Publishing Group},
	keywords = {Behavioral Sciences, Biological Psychology, general, Medicine/Public Health, Neurosciences, Pharmacotherapy, Psychiatry},
	pages = {1343--1353},
	file = {Full Text PDF:/Users/alighareeb/Zotero/storage/2YERTQTA/Lei et al. - 2008 - The Role of Akt-GSK-3\textbeta Signaling and Synaptic Strength in Phencyclidine-Induced Neurodegeneration.pdf:application/pdf},
}

@article{hirota_identification_2012,
	title = {Identification of {Small} {Molecule} {Activators} of {Cryptochrome}},
	volume = {337},
	issn = {0036-8075},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3589997/},
	doi = {10.1126/science.1223710},
	abstract = {Impairment of the circadian clock has been associated with numerous disorders, including metabolic disease. Although small molecules that modulate clock function might offer therapeutic approaches to such diseases, only a few compound have been identified that selectively target core clock proteins. From an unbiased cell-based circadian screen, we identified KL001, a small molecule that specifically interacts with cryptochrome (CRY). KL001 prevented ubiquitin-dependent degradation of CRY, resulting in lengthening of the circadian period. In combination with mathematical modeling, KL001 revealed that CRY1 and CRY2 share a similar functional role in the period regulation. Furthermore, KL001- mediated CRY stabilization inhibited glucagon-induced gluconeogenesis in primary hepatocytes. KL001 thus provides a tool to study the regulation of CRY-dependent physiology and aid development of clock-based therapeutics of diabetes.},
	number = {6098},
	urldate = {2025-05-17},
	journal = {Science (New York, N.Y.)},
	author = {Hirota, Tsuyoshi and Lee, Jae Wook and St. John, Peter C. and Sawa, Mariko and Iwaisako, Keiko and Noguchi, Takako and Pongsawakul, Pagkapol Y. and Sonntag, Tim and Welsh, David K. and Brenner, David A. and Doyle, Francis J. and Schultz, Peter G. and Kay, Steve A.},
	month = aug,
	year = {2012},
	pmid = {22798407},
