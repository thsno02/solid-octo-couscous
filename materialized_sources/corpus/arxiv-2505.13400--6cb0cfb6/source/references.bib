	pages = {1094--1097},
	file = {Full Text:/Users/alighareeb/Zotero/storage/NUZGF3Q9/Hirota et al. - 2012 - Identification of Small Molecule Activators of Cryptochrome.pdf:application/pdf},
}

@article{sartawi_bone_2020,
	title = {Bone regenerative potential of the selective sphingosine 1-phosphate receptor modulator siponimod: \textit{{In} vitro} characterisation using osteoblast and endothelial cells},
	volume = {882},
	issn = {0014-2999},
	shorttitle = {Bone regenerative potential of the selective sphingosine 1-phosphate receptor modulator siponimod},
	url = {https://www.sciencedirect.com/science/article/pii/S001429992030354X},
	doi = {10.1016/j.ejphar.2020.173262},
	abstract = {The repair of critical bone defects remains a significant therapeutic challenge. While the implantation of drug-eluting scaffolds is an option, a drug with the optimal pharmacological properties has not yet been identified. Agents acting at sphingosine 1-phosphate (S1P) receptors have been considered, but those investigated so far do not discriminate between the five known S1P receptors. This work was undertaken to investigate the potential of the specific S1P1/5 modulator siponimod as a bone regenerative agent, by testing in vitro its effect on cell types critical to the bone regeneration process. hFOB osteoblasts and HUVEC endothelial cells were treated with siponimod and other S1P receptor modulators and investigated for changes in intracellular cyclic AMP content, viability, proliferation, differentiation, attachment and cellular motility. Siponimod showed no effect on the viability and proliferation of osteoblasts and endothelial cells, but increased osteoblast differentiation (as shown by increased alkaline phosphatase activity). Furthermore, siponimod significantly increased endothelial cell motility in scratch and transwell migration assays. These effects on osteoblast differentiation and endothelial cell migration suggest that siponimod may be a potential agent for the stimulation of localised differentiation of osteoblasts in critical bone defects.},
	urldate = {2025-05-17},
	journal = {European Journal of Pharmacology},
	author = {Sartawi, Ziad and Ryan, Katie B. and Waeber, Christian},
	month = sep,
	year = {2020},
	keywords = {HUVEC, Osteoblasts, S1P receptors, Siponimod, Sphingosine 1-phosphate},
	pages = {173262},
	file = {ScienceDirect Snapshot:/Users/alighareeb/Zotero/storage/WZ9Q5XVF/S001429992030354X.html:text/html},
}

@article{kang_-ionone_2013,
	title = {\textbeta-{Ionone} attenuates {LPS}-induced pro-inflammatory mediators such as {NO}, {PGE2} and {TNF}-\textalpha in {BV2} microglial cells via suppression of the {NF}-\textkappa{B} and {MAPK} pathway},
	volume = {27},
	issn = {0887-2333},
	url = {https://www.sciencedirect.com/science/article/pii/S0887233312003505},
	doi = {10.1016/j.tiv.2012.12.012},
	abstract = {\textbeta-Ionone, a precursor of carotenoids, possesses a variety of biological properties such as anti-cancerous, anti-mutagenic and anti-microbial activity. Nevertheless, anti-inflammatory effects of \textbeta-ionone remain unknown. In this study, we investigated whether ION attenuates the expression of lipopolysaccharide (LPS)-induced pro-inflammatory mediators such as nitric oxide (NO), prostaglandin E2 (PGE2) and tumor necrosis factor-\textalpha (TNF-\textalpha) in BV2 microglia cells. Our data showed that \textbeta-ionone significantly inhibits secretion of NO, PGE2 and TNF-\textalpha. \textbeta-Ionone also inhibits the expression of inducible NO synthesis (iNOS), cyclooxygenase-2 (COX-2) and TNF-\textalpha protein and their mRNA in LPS-stimulated BV2 microglia cells. In addition, \textbeta-ionone significantly reduced DNA-binding activity of nuclear factor-\textkappa B (NF-\textkappa B) through suppression of nuclear translocation of p50 and p65. We showed that NF-\textkappa B inhibitor N-acetyl-L-cysteine (NAC) effectively attenuates the expression of LPS-stimulated iNOS, COX-2 and TNF-\textalpha. We also found that LPS-induced NF-\textkappa B activation is significantly regulated through inhibition of Akt phosphorylation in the presence of \textbeta-ionone. Finally, we showed that \textbeta-ionone substantially inhibits the phosphorylation of mitogen-activated protein kinases (MAPKs), including ERK1/2, p38 and JNK, which are closely related to regulation of pro-inflammatory mediator secretion. Taken together, these data imply that \textbeta-ionone regulates LPS-induced NF-\textkappa B-dependent inflammatory pathways through suppression of Akt and MAPK activation.},
	number = {2},
	urldate = {2025-05-17},
	journal = {Toxicology in Vitro},
	author = {Kang, Chang-Hee and Jayasooriya, Rajapaksha Gendara Prasad Tharanga and Choi, Yung Hyun and Moon, Sung-Kwon and Kim, Wun-Jae and Kim, Gi-Young},
	month = mar,
	year = {2013},
	keywords = {Akt, Nitric oxide, Nuclear factor-\textkappa B, Prostaglandin E, Tumor necrosis factor-\textalpha, \textbeta-Ionone},
	pages = {782--787},
	file = {ScienceDirect Snapshot:/Users/alighareeb/Zotero/storage/R2B9IPMJ/S0887233312003505.html:text/html},
}


